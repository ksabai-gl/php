# Copy to .env and adjust for your environment.
# The Node.js server preserves the legacy MySQL schema and API-key contract.

PORT=8088
NODE_ENV=development
LOG_LEVEL=info

# CORS: comma-separated list of allowed web origins. Use * only in dev.
CORS_ORIGIN=http://localhost:5173

# MySQL connection (matches the legacy backend/config/database.php defaults).
DB_HOST=localhost
DB_PORT=3306
DB_USER=emp_user
DB_PASS=emp_pass
DB_NAME=employee_portal
DB_CONNECTION_LIMIT=10

# Legacy shared secret used by the React SPA and any remaining portlet clients.
# The middleware accepts it via the X-API-Key header (or ?api_key= query for
# backward compatibility with the retired PHP endpoints).
API_KEY=EMP-PORTAL-LEGACY-KEY-2014
